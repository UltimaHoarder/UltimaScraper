{
  "name": "webui",
  "private": true,
  "version": "0.2.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.vitest.json --noEmit",
    "test:unit:watch": "vitest",
    "test:smoke": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "test:webui": "npm run test:unit && npm run test:smoke"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.16",
    "@uiw/react-json-view": "^2.0.0-alpha.41",
    "axios": "^1.21.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "three": "^0.183.2",
    "video.js": "^8.23.7",
    "videojs-contrib-eme": "^5.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
